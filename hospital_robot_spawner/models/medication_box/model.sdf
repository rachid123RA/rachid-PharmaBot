<?xml version="1.0"?>
<sdf version="1.6">
<model name="medication_box">
  <!-- Boîte de médicaments transportée par le robot -->
  <link name="link">
    <inertial>
      <mass>0.3</mass>
      <inertia>
        <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.001</iyy><iyz>0</iyz>
        <izz>0.001</izz>
      </inertia>
    </inertial>

    <collision name="col">
      <geometry>
        <box><size>0.20 0.12 0.10</size></box>
      </geometry>
    </collision>

    <!-- Corps blanc de la boîte -->
    <visual name="box_body">
      <geometry>
        <box><size>0.20 0.12 0.10</size></box>
      </geometry>
      <material>
        <ambient>0.95 0.95 0.95 1</ambient>
        <diffuse>0.95 0.95 0.95 1</diffuse>
      </material>
    </visual>

    <!-- Croix rouge médicale (face avant) -->
    <visual name="cross_h">
      <pose>0.101 0 0 0 1.5707 0</pose>
      <geometry>
        <box><size>0.015 0.08 0.02</size></box>
      </geometry>
      <material>
        <ambient>0.9 0.1 0.1 1</ambient>
        <diffuse>0.9 0.1 0.1 1</diffuse>
        <emissive>0.3 0 0 1</emissive>
      </material>
    </visual>
    <visual name="cross_v">
      <pose>0.101 0 0 0 1.5707 0</pose>
      <geometry>
        <box><size>0.015 0.02 0.08</size></box>
      </geometry>
      <material>
        <ambient>0.9 0.1 0.1 1</ambient>
        <diffuse>0.9 0.1 0.1 1</diffuse>
        <emissive>0.3 0 0 1</emissive>
      </material>
    </visual>

    <!-- Bord vert (label pharmacie) -->
    <visual name="label_top">
      <pose>0 0 0.051 0 0 0</pose>
      <geometry>
        <box><size>0.20 0.12 0.002</size></box>
      </geometry>
      <material>
        <ambient>0.1 0.7 0.2 1</ambient>
        <diffuse>0.1 0.7 0.2 1</diffuse>
      </material>
    </visual>
  </link>
</model>
</sdf>
