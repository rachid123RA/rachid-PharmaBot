<?xml version="1.0"?>
<!--
  Pioneer 3AT — Modèle SDF pour PharmaBot
  Robot mobile 4 roues (skid-steer) avec :
    - Châssis principal (corps rouge PharmaBot)
    - 4 roues avec physique réelle
    - Capteur LiDAR 360° (Hokuyo simulé)
    - Caméra frontale
    - Plugin diff-drive ROS2 → /demo/cmd_vel, /demo/odom
    - Plugin laser → /demo/scan
    - Plugin caméra → /demo/image_raw
    - LED bleue sur le dessus (indicateur de statut)
    - Antenne visible
-->
<sdf version="1.6">
<model name="PharmaBot">
  <pose>0 0 0.3 0 0 0</pose>

  <!-- ══════════════════════ CHÂSSIS PRINCIPAL ══════════════════════ -->
  <link name="base_link">
    <pose>0 0 0.1 0 0 0</pose>

    <inertial>
      <mass>15.0</mass>
      <inertia>
        <ixx>0.3738</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.5015</iyy><iyz>0</iyz>
        <izz>0.7243</izz>
      </inertia>
    </inertial>

    <!-- Corps principal rouge -->
    <collision name="base_collision">
      <geometry>
        <box><size>0.50 0.38 0.20</size></box>
      </geometry>
    </collision>
    <visual name="base_visual">
      <geometry>
        <box><size>0.50 0.38 0.20</size></box>
      </geometry>
      <material>
        <ambient>0.85 0.1 0.1 1</ambient>
        <diffuse>0.85 0.1 0.1 1</diffuse>
        <specular>0.3 0.3 0.3 1</specular>
      </material>
    </visual>

    <!-- Dessus du robot (gris foncé) -->
    <visual name="top_visual">
      <pose>0 0 0.12 0 0 0</pose>
      <geometry>
        <box><size>0.40 0.30 0.04</size></box>
      </geometry>
      <material>
        <ambient>0.2 0.2 0.2 1</ambient>
        <diffuse>0.2 0.2 0.2 1</diffuse>
      </material>
    </visual>

    <!-- LED bleue (indicateur actif) -->
    <visual name="led_visual">
      <pose>0.15 0 0.15 0 0 0</pose>
      <geometry>
        <sphere><radius>0.025</radius></sphere>
      </geometry>
      <material>
        <ambient>0 0.5 1 1</ambient>
        <diffuse>0 0.5 1 1</diffuse>
        <emissive>0 0.3 1 1</emissive>
      </material>
    </visual>

    <!-- Antenne -->
    <visual name="antenna_visual">
      <pose>-0.15 0.1 0.25 0 0 0</pose>
      <geometry>
        <cylinder><radius>0.008</radius><length>0.3</length></cylinder>
      </geometry>
      <material>
        <ambient>0.1 0.1 0.1 1</ambient>
        <diffuse>0.1 0.1 0.1 1</diffuse>
      </material>
    </visual>

    <!-- Boîte de livraison sur le robot -->
    <visual name="cargo_bay">
      <pose>0 0 0.16 0 0 0</pose>
      <geometry>
        <box><size>0.30 0.25 0.08</size></box>
      </geometry>
      <material>
        <ambient>0.7 0.7 0.9 1</ambient>
        <diffuse>0.7 0.7 0.9 1</diffuse>
      </material>
    </visual>

    <!-- ══════════════════════ LIDAR ══════════════════════ -->
    <sensor name="hokuyo_lidar" type="ray">
      <pose>0.0 0 0.21 0 0 0</pose>
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="laser_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/demo</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>base_link</frame_name>
      </plugin>
    </sensor>

    <!-- ══════════════════════ CAMÉRA ══════════════════════ -->
    <sensor name="front_camera" type="camera">
      <pose>0.26 0 0.08 0 0.1 0</pose>
      <always_on>1</always_on>
      <update_rate>15</update_rate>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/demo</namespace>
          <remapping>image_raw:=image_raw</remapping>
          <remapping>camera_info:=camera_info</remapping>
        </ros>
        <camera_name>front_camera</camera_name>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>

    <!-- Visuel LiDAR (cylindre tournant) -->
    <visual name="lidar_body">
      <pose>0 0 0.22 0 0 0</pose>
      <geometry>
        <cylinder><radius>0.04</radius><length>0.06</length></cylinder>
      </geometry>
      <material>
        <ambient>0.1 0.1 0.1 1</ambient>
        <diffuse>0.1 0.1 0.1 1</diffuse>
      </material>
    </visual>

  </link>

  <!-- ══════════════════════ ROUE AVANT GAUCHE ══════════════════════ -->
  <link name="front_left_wheel">
    <pose>0.19 0.22 0 0 1.5707 0</pose>
    <inertial>
      <mass>1.5</mass>
      <inertia>
        <ixx>0.0051</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.0051</iyy><iyz>0</iyz>
        <izz>0.0090</izz>
      </inertia>
    </inertial>
    <collision name="col">
      <geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
      <surface>
        <friction>
          <ode><mu>1.5</mu><mu2>1.5</mu2><slip1>0.02</slip1><slip2>0.02</slip2></ode>
        </friction>
      </surface>
    </collision>
    <visual name="vis">
      <geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
      <material>
        <ambient>0.1 0.1 0.1 1</ambient>
        <diffuse>0.1 0.1 0.1 1</diffuse>
      </material>
    </visual>
    <!-- Jante -->
    <visual name="rim">
      <geometry><cylinder><radius>0.07</radius><length>0.082</length></cylinder></geometry>
      <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
    </visual>
  </link>

  <!-- ══════════════════════ ROUE AVANT DROITE ══════════════════════ -->
  <link name="front_right_wheel">
    <pose>0.19 -0.22 0 0 1.5707 0</pose>
    <inertial>
      <mass>1.5</mass>
      <inertia>
        <ixx>0.0051</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.0051</iyy><iyz>0</iyz>
        <izz>0.0090</izz>
      </inertia>
    </inertial>
    <collision name="col">
      <geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
      <surface>
        <friction>
          <ode><mu>1.5</mu><mu2>1.5</mu2><slip1>0.02</slip1><slip2>0.02</slip2></ode>
        </friction>
      </surface>
    </collision>
    <visual name="vis">
      <geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
      <material>
        <ambient>0.1 0.1 0.1 1</ambient>
        <diffuse>0.1 0.1 0.1 1</diffuse>
      </material>
    </visual>
    <visual name="rim">
      <geometry><cylinder><radius>0.07</radius><length>0.082</length></cylinder></geometry>
      <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
    </visual>
  </link>

  <!-- ══════════════════════ ROUE ARRIÈRE GAUCHE ════════════════════ -->
  <link name="back_left_wheel">
    <pose>-0.19 0.22 0 0 1.5707 0</pose>
    <inertial>
      <mass>1.5</mass>
      <inertia>
        <ixx>0.0051</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.0051</iyy><iyz>0</iyz>
        <izz>0.0090</izz>
      </inertia>
    </inertial>
    <collision name="col">
      <geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
      <surface>
        <friction>
          <ode><mu>1.5</mu><mu2>1.5</mu2><slip1>0.02</slip1><slip2>0.02</slip2></ode>
        </friction>
      </surface>
    </collision>
    <visual name="vis">
      <geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
      <material>
        <ambient>0.1 0.1 0.1 1</ambient>
        <diffuse>0.1 0.1 0.1 1</diffuse>
      </material>
    </visual>
    <visual name="rim">
      <geometry><cylinder><radius>0.07</radius><length>0.082</length></cylinder></geometry>
      <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
    </visual>
  </link>

  <!-- ══════════════════════ ROUE ARRIÈRE DROITE ════════════════════ -->
  <link name="back_right_wheel">
    <pose>-0.19 -0.22 0 0 1.5707 0</pose>
    <inertial>
      <mass>1.5</mass>
      <inertia>
        <ixx>0.0051</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.0051</iyy><iyz>0</iyz>
        <izz>0.0090</izz>
      </inertia>
    </inertial>
    <collision name="col">
      <geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
      <surface>
        <friction>
          <ode><mu>1.5</mu><mu2>1.5</mu2><slip1>0.02</slip1><slip2>0.02</slip2></ode>
        </friction>
      </surface>
    </collision>
    <visual name="vis">
      <geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
      <material>
        <ambient>0.1 0.1 0.1 1</ambient>
        <diffuse>0.1 0.1 0.1 1</diffuse>
      </material>
    </visual>
    <visual name="rim">
      <geometry><cylinder><radius>0.07</radius><length>0.082</length></cylinder></geometry>
      <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
    </visual>
  </link>

  <!-- ══════════════════════ JOINTS ══════════════════════ -->
  <joint name="front_left_wheel_joint" type="revolute">
    <parent>base_link</parent>
    <child>front_left_wheel</child>
    <axis>
      <xyz>0 0 1</xyz>
      <dynamics><damping>0.05</damping></dynamics>
    </axis>
  </joint>

  <joint name="front_right_wheel_joint" type="revolute">
    <parent>base_link</parent>
    <child>front_right_wheel</child>
    <axis>
      <xyz>0 0 1</xyz>
      <dynamics><damping>0.05</damping></dynamics>
    </axis>
  </joint>

  <joint name="back_left_wheel_joint" type="revolute">
    <parent>base_link</parent>
    <child>back_left_wheel</child>
    <axis>
      <xyz>0 0 1</xyz>
      <dynamics><damping>0.05</damping></dynamics>
    </axis>
  </joint>

  <joint name="back_right_wheel_joint" type="revolute">
    <parent>base_link</parent>
    <child>back_right_wheel</child>
    <axis>
      <xyz>0 0 1</xyz>
      <dynamics><damping>0.05</damping></dynamics>
    </axis>
  </joint>

  <!-- ══════════════════════ PLUGIN DIFF DRIVE ROS2 ════════════════ -->
  <!--
    Contrôle les 4 roues en diff drive.
    Topics: /demo/cmd_vel  (input)
            /demo/odom     (output)
    Ces noms correspondent exactement à navigation_bridge.py et delivery_detector.py
  -->
  <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
    <ros>
      <namespace>/demo</namespace>
    </ros>

    <update_rate>20</update_rate>

    <!-- Paires de roues gauches -->
    <left_joint>front_left_wheel_joint</left_joint>
    <left_joint>back_left_wheel_joint</left_joint>
    <!-- Paires de roues droites -->
    <right_joint>front_right_wheel_joint</right_joint>
    <right_joint>back_right_wheel_joint</right_joint>

    <wheel_separation>0.44</wheel_separation>
    <wheel_diameter>0.22</wheel_diameter>

    <max_wheel_acceleration>2.0</max_wheel_acceleration>
    <max_wheel_torque>25</max_wheel_torque>

    <command_topic>cmd_vel</command_topic>
    <odometry_topic>odom</odometry_topic>
    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_link</robot_base_frame>

    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
    <publish_wheel_tf>false</publish_wheel_tf>
  </plugin>

</model>
</sdf>
