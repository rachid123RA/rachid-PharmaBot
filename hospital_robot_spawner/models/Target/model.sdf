<?xml version="1.0"?>
<sdf version="1.6">
<model name="Target">
  <static>true</static>
  <link name="link">
    <!-- Base verte -->
    <visual name="base">
      <pose>0 0 0.02 0 0 0</pose>
      <geometry>
        <cylinder><radius>0.5</radius><length>0.04</length></cylinder>
      </geometry>
      <material>
        <ambient>0 0.9 0.1 0.7</ambient>
        <diffuse>0 0.9 0.1 0.7</diffuse>
        <emissive>0 0.3 0 1</emissive>
      </material>
    </visual>
    <!-- Flèche verticale -->
    <visual name="arrow">
      <pose>0 0 0.3 0 0 0</pose>
      <geometry>
        <cylinder><radius>0.05</radius><length>0.6</length></cylinder>
      </geometry>
      <material>
        <ambient>0 0.9 0.1 1</ambient>
        <diffuse>0 0.9 0.1 1</diffuse>
        <emissive>0 0.5 0 1</emissive>
      </material>
    </visual>
    <!-- Pointe de flèche -->
    <visual name="arrow_tip">
      <pose>0 0 0.65 0 0 0</pose>
      <geometry>
        <cone><radius>0.12</radius><length>0.2</length></cone>
      </geometry>
      <material>
        <ambient>1 0.8 0 1</ambient>
        <diffuse>1 0.8 0 1</diffuse>
        <emissive>0.5 0.4 0 1</emissive>
      </material>
    </visual>
    <collision name="col">
      <pose>0 0 0.02 0 0 0</pose>
      <geometry><cylinder><radius>0.5</radius><length>0.04</length></cylinder></geometry>
    </collision>
  </link>
</model>
</sdf>
