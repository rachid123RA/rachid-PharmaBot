        <material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.7 0.72 0.75 1</diffuse></material></visual>
      <visual name="rb_r"><pose>0 -0.17 0.56 0 0 0</pose><geometry><box><size>0.46 0.02 0.06</size></box></geometry>
        <material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.7 0.72 0.75 1</diffuse></material></visual>

