  <!-- ═══════════════════ ROBOT PHARMABOT ELEGANT ═══════════════════
    Position initiale : Pharmacie (1.0, 16.0)
    Design : chassis blanc + 4 piliers chromees + plateau livraison
  ════════════════════════════════════════════════════════════════ -->
  <model name="PharmaBot">
    <pose>1.0 16.0 0.22 0 0 0</pose>

    <link name="base_link">
      <pose>0 0 0.06 0 0 0</pose>
      <inertial><mass>12.0</mass>
        <inertia><ixx>0.3</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.45</iyy><iyz>0</iyz><izz>0.65</izz></inertia>
      </inertial>

      <!-- Chassis bas blanc -->
      <collision name="cc"><geometry><box><size>0.52 0.4 0.14</size></box></geometry></collision>
      <visual name="chassis"><geometry><box><size>0.52 0.4 0.14</size></box></geometry>
        <material><ambient>0.95 0.95 0.97 1</ambient><diffuse>0.95 0.95 0.97 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
      <!-- Bandes bleues -->
