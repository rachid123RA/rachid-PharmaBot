      <visual name="rb_b"><pose>-0.23 0 0.56 0 0 0</pose><geometry><box><size>0.02 0.34 0.06</size></box></geometry>
        <material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.7 0.72 0.75 1</diffuse></material></visual>
