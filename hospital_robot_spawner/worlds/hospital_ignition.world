  <model name="sp4"><static>true</static><pose>-4.3 16 0.4 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>0.25 7.5 0.04</size></box></geometry><material><ambient>0.8 0.6 0.3 1</ambient><diffuse>0.8 0.6 0.3 1</diffuse></material></visual></link></model>
  <model name="sp5"><static>true</static><pose>-4.3 16 1.1 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>0.25 7.5 0.04</size></box></geometry><material><ambient>0.8 0.6 0.3 1</ambient><diffuse>0.8 0.6 0.3 1</diffuse></material></visual></link></model>

