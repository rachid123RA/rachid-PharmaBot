<?xml version="1.0"?>
<!--
  hospital_ignition.world — PharmaBot Gazebo 3D ENRICHI
  ═══════════════════════════════════════════════════════
  🟦 Pharmacie     (1.0,  16.0) — départ robot
  🟥 Réanimation  (11.0,   5.5) — HARD_RT 30s
  🟧 Urgences     (-5.0,  -6.6) — SOFT_RT 120s
  🟩 Consultation (-2.0, -27.0) — FIRM_RT 300s
  🔵 Salle attente (2.0,  10.0) — nouveau
  🟫 Radiologie   (15.0,  -5.0) — nouveau
  🩵 Chirurgie    (-3.0, -15.0) — nouveau

  Personnes : 3 infirmières · 2 patients âgés · 1 médecin
  Obstacles  : 4 chariots médicaux · 2 fauteuils roulants · 3 bancs
  Médicaments: 18 boîtes + 8 flacons sur étagères
-->
<sdf version="1.9">
<world name="hospital">

  <!-- ══ PLUGINS SYSTÈME IGNITION ══════════════════════════════════ -->
  <plugin filename="ignition-gazebo-physics-system"
          name="ignition::gazebo::systems::Physics"/>
  <plugin filename="ignition-gazebo-user-commands-system"
          name="ignition::gazebo::systems::UserCommands"/>
  <plugin filename="ignition-gazebo-scene-broadcaster-system"
          name="ignition::gazebo::systems::SceneBroadcaster"/>
  <plugin filename="ignition-gazebo-sensors-system"
          name="ignition::gazebo::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>

  <physics name="default_physics" default="true" type="ode">
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1.0</real_time_factor>
    <real_time_update_rate>1000</real_time_update_rate>
  </physics>

  <!-- ══ LUMIÈRES ══════════════════════════════════════════════════ -->
  <light name="sun" type="directional">
    <pose>0 0 20 0 0 0</pose><cast_shadows>true</cast_shadows>
    <diffuse>0.85 0.85 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular>
    <direction>-0.5 0.1 -0.9</direction>
    <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
  </light>
  <light name="lp1" type="point"><pose>1 16 2.8 0 0 0</pose><diffuse>0.5 0.5 1.0 1</diffuse><specular>0.1 0.1 0.3 1</specular><attenuation><range>10</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
  <light name="lp2" type="point"><pose>11 5.5 2.8 0 0 0</pose><diffuse>1.0 0.4 0.4 1</diffuse><specular>0.3 0.1 0.1 1</specular><attenuation><range>10</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
  <light name="lp3" type="point"><pose>-5 -6.6 2.8 0 0 0</pose><diffuse>1.0 0.6 0.2 1</diffuse><specular>0.3 0.2 0.1 1</specular><attenuation><range>10</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
  <light name="lp4" type="point"><pose>-2 -27 2.8 0 0 0</pose><diffuse>0.4 1.0 0.4 1</diffuse><specular>0.1 0.3 0.1 1</specular><attenuation><range>10</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
  <light name="lp5" type="point"><pose>2 10 2.8 0 0 0</pose><diffuse>0.9 0.9 0.6 1</diffuse><specular>0.2 0.2 0.1 1</specular><attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation><cast_shadows>false</cast_shadows></light>

  <!-- ══ SOL HÔPITAL ═══════════════════════════════════════════════ -->
  <model name="hospital_floor"><static>true</static><pose>0 -8 -0.05 0 0 0</pose>
    <link name="l"><collision name="c"><geometry><box><size>50 90 0.1</size></box></geometry></collision>
    <visual name="v"><geometry><box><size>50 90 0.1</size></box></geometry>
    <material><ambient>0.82 0.82 0.82 1</ambient><diffuse>0.82 0.82 0.82 1</diffuse></material></visual></link></model>

  <!-- ══ MURS EXTÉRIEURS ═══════════════════════════════════════════ -->
  <model name="wall_n"><static>true</static><pose>2 26 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>50 0.3 3</size></box></geometry></collision><visual name="v"><geometry><box><size>50 0.3 3</size></box></geometry><material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.88 0.88 0.88 1</diffuse></material></visual></link></model>
  <model name="wall_s"><static>true</static><pose>2 -36 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>50 0.3 3</size></box></geometry></collision><visual name="v"><geometry><box><size>50 0.3 3</size></box></geometry><material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.88 0.88 0.88 1</diffuse></material></visual></link></model>
  <model name="wall_e"><static>true</static><pose>26 -5 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.3 62 3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 62 3</size></box></geometry><material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.88 0.88 0.88 1</diffuse></material></visual></link></model>
  <model name="wall_w"><static>true</static><pose>-22 -5 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.3 62 3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 62 3</size></box></geometry><material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.88 0.88 0.88 1</diffuse></material></visual></link></model>

  <!-- ══ COULOIRS ══════════════════════════════════════════════════ -->
  <model name="corridor_main"><static>true</static><pose>1 -5 0.02 0 0 0</pose>
    <link name="l"><visual name="v"><geometry><box><size>4 62 0.02</size></box></geometry>
    <material><ambient>0.72 0.72 0.78 1</ambient><diffuse>0.72 0.72 0.78 1</diffuse></material></visual></link></model>
  <model name="corridor_h1"><static>true</static><pose>7 5.5 0.02 0 0 0</pose>
    <link name="l"><visual name="v"><geometry><box><size>10 4 0.02</size></box></geometry>
    <material><ambient>0.72 0.72 0.78 1</ambient><diffuse>0.72 0.72 0.78 1</diffuse></material></visual></link></model>
  <model name="corridor_h2"><static>true</static><pose>-3 -6.6 0.02 0 0 0</pose>
    <link name="l"><visual name="v"><geometry><box><size>6 4 0.02</size></box></geometry>
    <material><ambient>0.72 0.72 0.78 1</ambient><diffuse>0.72 0.72 0.78 1</diffuse></material></visual></link></model>
  <model name="corridor_h3"><static>true</static><pose>-2 -20 0.02 0 0 0</pose>
    <link name="l"><visual name="v"><geometry><box><size>4 10 0.02</size></box></geometry>
    <material><ambient>0.72 0.72 0.78 1</ambient><diffuse>0.72 0.72 0.78 1</diffuse></material></visual></link></model>
  <model name="corridor_rad"><static>true</static><pose>13 -5 0.02 0 0 0</pose>
    <link name="l"><visual name="v"><geometry><box><size>8 4 0.02</size></box></geometry>
    <material><ambient>0.72 0.72 0.78 1</ambient><diffuse>0.72 0.72 0.78 1</diffuse></material></visual></link></model>

  <!-- ══════════════ 🟦 PHARMACIE (1.0, 16.0) AMÉLIORÉE ════════════ -->
  <model name="pharmacy_floor"><static>true</static><pose>1 16 0.03 0 0 0</pose>
    <link name="l"><visual name="v"><geometry><box><size>14 10 0.02</size></box></geometry>
    <material><ambient>0.18 0.38 0.88 1</ambient><diffuse>0.18 0.38 0.88 1</diffuse></material></visual></link></model>
  <model name="ph_w_n"><static>true</static><pose>1 21 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>14 0.2 3</size></box></geometry></collision><visual name="v"><geometry><box><size>14 0.2 3</size></box></geometry><material><ambient>0.78 0.84 1.0 1</ambient><diffuse>0.78 0.84 1.0 1</diffuse></material></visual></link></model>
