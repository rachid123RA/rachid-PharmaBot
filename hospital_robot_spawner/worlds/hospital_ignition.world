    </link>

    <joint name="fl_j" type="revolute"><parent>base_link</parent><child>fl_wheel</child><axis><xyz>0 0 1</xyz><dynamics><damping>0.04</damping></dynamics></axis></joint>
    <joint name="fr_j" type="revolute"><parent>base_link</parent><child>fr_wheel</child><axis><xyz>0 0 1</xyz><dynamics><damping>0.04</damping></dynamics></axis></joint>
    <joint name="rl_j" type="revolute"><parent>base_link</parent><child>rl_wheel</child><axis><xyz>0 0 1</xyz><dynamics><damping>0.04</damping></dynamics></axis></joint>
    <joint name="rr_j" type="revolute"><parent>base_link</parent><child>rr_wheel</child><axis><xyz>0 0 1</xyz><dynamics><damping>0.04</damping></dynamics></axis></joint>

    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>fl_j</left_joint><left_joint>rl_j</left_joint>
      <right_joint>fr_j</right_joint><right_joint>rr_j</right_joint>
      <wheel_separation>0.46</wheel_separation>
      <wheel_radius>0.115</wheel_radius>
      <max_linear_velocity>1.5</max_linear_velocity>
      <max_angular_velocity>2.5</max_angular_velocity>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <topic>/demo/cmd_vel</topic>
      <odom_topic>/demo/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>

    <!-- RGB CAMERA -->
    <link name="cam_rgb_link">
      <pose>0.28 0 0.74 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
      <visual name="cam_body"><geometry><box><size>0.04 0.08 0.04</size></box></geometry>
        <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material></visual>
      <visual name="cam_lens"><pose>0.022 0 0 0 1.5707 0</pose><geometry><cylinder><radius>0.014</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.05 0.1 0.3 1</ambient><diffuse>0.05 0.1 0.3 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
      <sensor name="rgb_camera" type="camera">
        <pose>0 0 0 0 0 0</pose><topic>/demo/camera/rgb</topic><update_rate>15</update_rate>
        <camera><horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>10.0</far></clip></camera>
        <always_on>1</always_on><visualize>false</visualize>
      </sensor>
    </link>
    <joint name="cam_rgb_j" type="fixed"><parent>base_link</parent><child>cam_rgb_link</child></joint>

    <!-- DEPTH CAMERA -->
    <link name="cam_depth_link">
      <pose>0.26 0 0.70 0 0 0</pose>
      <inertial><mass>0.08</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
      <visual name="depth_body"><geometry><box><size>0.05 0.06 0.03</size></box></geometry>
        <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material></visual>
      <visual name="depth_led"><pose>0.026 0 0.008 0 1.5707 0</pose><geometry><cylinder><radius>0.006</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.9 0.15 0 1</ambient><diffuse>0.9 0.15 0 1</diffuse><emissive>0.35 0.05 0 1</emissive></material></visual>
      <sensor name="depth_camera" type="depth_camera">
        <pose>0 0 0 0 0 0</pose><topic>/demo/camera/depth</topic><update_rate>10</update_rate>
        <camera><horizontal_fov>1.047</horizontal_fov>
          <image><width>320</width><height>240</height><format>R_FLOAT32</format></image>
          <clip><near>0.1</near><far>8.0</far></clip></camera>
        <always_on>1</always_on><visualize>false</visualize>
      </sensor>
    </link>
    <joint name="cam_depth_j" type="fixed"><parent>base_link</parent><child>cam_depth_link</child></joint>

    <!-- IMU -->
    <link name="imu_link">
      <pose>0 0 0.1 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia></inertial>
      <sensor name="imu_sensor" type="imu">
        <topic>/demo/imu</topic><update_rate>100</update_rate><always_on>1</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <joint name="imu_j" type="fixed"><parent>base_link</parent><child>imu_link</child></joint>

