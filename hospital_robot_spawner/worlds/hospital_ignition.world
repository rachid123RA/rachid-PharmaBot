        <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>
      <visual name="ecran"><pose>0.08 0 0.78 0 0 0</pose><geometry><box><size>0.18 0.02 0.12</size></box></geometry>
        <material><ambient>0.1 0.45 0.9 1</ambient><diffuse>0.1 0.45 0.9 1</diffuse><emissive>0.04 0.18 0.36 1</emissive></material></visual>

      <!-- LEDs status -->
      <visual name="led_g"><pose>0.27 0 0.05 0 0 0</pose><geometry><sphere><radius>0.018</radius></sphere></geometry>
        <material><ambient>0 0.9 0 1</ambient><diffuse>0 0.9 0 1</diffuse><emissive>0 0.4 0 1</emissive></material></visual>
      <visual name="led_b"><pose>0.27 0.07 0.05 0 0 0</pose><geometry><sphere><radius>0.018</radius></sphere></geometry>
        <material><ambient>0 0.4 1 1</ambient><diffuse>0 0.4 1 1</diffuse><emissive>0 0.15 0.5 1</emissive></material></visual>

      <!-- LiDAR 360 -->
      <visual name="lidar_corp"><pose>0 0 0.84 0 0 0</pose><geometry><cylinder><radius>0.045</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.1 0.1 0.12 1</diffuse></material></visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.85 0 0 0</pose><topic>/demo/scan</topic><update_rate>10</update_rate>
        <lidar>
          <scan><horizontal><samples>360</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
        </lidar>
        <always_on>1</always_on><visualize>true</visualize>
      </sensor>
    </link>

    <link name="fl_wheel"><pose>0.20 0.23 0 0 1.5707 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.006</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.006</iyy><iyz>0</iyz><izz>0.010</izz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.115</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
      <visual name="p"><geometry><cylinder><radius>0.115</radius><length>0.08</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="j"><geometry><cylinder><radius>0.075</radius><length>0.082</length></cylinder></geometry><material><ambient>0.65 0.66 0.68 1</ambient><diffuse>0.65 0.66 0.68 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
    </link>
    <link name="fr_wheel"><pose>0.20 -0.23 0 0 1.5707 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.006</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.006</iyy><iyz>0</iyz><izz>0.010</izz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.115</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
