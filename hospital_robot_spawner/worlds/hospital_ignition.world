<?xml version="1.0"?>
<sdf version="1.9">
<world name="hospital">

  <plugin filename="ignition-gazebo-physics-system"
          name="ignition::gazebo::systems::Physics"/>
  <plugin filename="ignition-gazebo-user-commands-system"
          name="ignition::gazebo::systems::UserCommands"/>
  <plugin filename="ignition-gazebo-scene-broadcaster-system"
          name="ignition::gazebo::systems::SceneBroadcaster"/>
  <plugin filename="ignition-gazebo-sensors-system"
          name="ignition::gazebo::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>

  <physics name="default_physics" default="true" type="ode">
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1.0</real_time_factor>
    <real_time_update_rate>1000</real_time_update_rate>
  </physics>

  <light name="sun" type="directional">
    <pose>0 0 30 0 0 0</pose><cast_shadows>true</cast_shadows>
    <diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular>
    <direction>-0.3 0.1 -0.9</direction>
    <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
  </light>
  <light name="spot1" type="point"><pose>1 10 3 0 0 0</pose><diffuse>0.95 0.95 1 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>12</range><constant>0.4</constant><linear>0.05</linear><quadratic>0.002</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
  <light name="spot2" type="point"><pose>1 -5 3 0 0 0</pose><diffuse>0.95 0.95 1 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>12</range><constant>0.4</constant><linear>0.05</linear><quadratic>0.002</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
  <light name="spot3" type="point"><pose>1 -20 3 0 0 0</pose><diffuse>0.95 0.95 1 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>12</range><constant>0.4</constant><linear>0.05</linear><quadratic>0.002</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
  <light name="spot4" type="point"><pose>8 20 3 0 0 0</pose><diffuse>0.8 0.9 1 1</diffuse><specular>0.1 0.1 0.2 1</specular><attenuation><range>14</range><constant>0.3</constant><linear>0.05</linear><quadratic>0.002</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
  <light name="spot5" type="point"><pose>11 7 3 0 0 0</pose><diffuse>1 0.92 0.88 1</diffuse><specular>0.1 0.05 0.05 1</specular><attenuation><range>14</range><constant>0.3</constant><linear>0.05</linear><quadratic>0.002</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
  <light name="spot6" type="point"><pose>-5 -7 3 0 0 0</pose><diffuse>1 0.95 0.85 1</diffuse><specular>0.1 0.08 0.05 1</specular><attenuation><range>14</range><constant>0.3</constant><linear>0.05</linear><quadratic>0.002</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
