        <material><ambient>0.08 0.3 0.85 1</ambient><diffuse>0.08 0.3 0.85 1</diffuse><emissive>0.02 0.08 0.25 1</emissive></material></visual>
      <visual name="bb_b"><pose>-0.25 0 0 0 0 0</pose><geometry><box><size>0.02 0.38 0.16</size></box></geometry>
        <material><ambient>0.08 0.3 0.85 1</ambient><diffuse>0.08 0.3 0.85 1</diffuse><emissive>0.02 0.08 0.25 1</emissive></material></visual>

      <!-- 4 piliers chromees -->
      <visual name="pil_ff"><pose>0.2 0.16 0.25 0 0 0</pose><geometry><cylinder><radius>0.022</radius><length>0.5</length></cylinder></geometry>
        <material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.7 0.72 0.75 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
      <visual name="pil_fr"><pose>0.2 -0.16 0.25 0 0 0</pose><geometry><cylinder><radius>0.022</radius><length>0.5</length></cylinder></geometry>
        <material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.7 0.72 0.75 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
      <visual name="pil_bf"><pose>-0.2 0.16 0.25 0 0 0</pose><geometry><cylinder><radius>0.022</radius><length>0.5</length></cylinder></geometry>
        <material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.7 0.72 0.75 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
      <visual name="pil_br"><pose>-0.2 -0.16 0.25 0 0 0</pose><geometry><cylinder><radius>0.022</radius><length>0.5</length></cylinder></geometry>
        <material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.7 0.72 0.75 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>

      <!-- PLATEAU LIVRAISON -->
      <visual name="plateau"><pose>0 0 0.52 0 0 0</pose><geometry><box><size>0.46 0.34 0.04</size></box></geometry>
        <material><ambient>0.96 0.96 0.98 1</ambient><diffuse>0.96 0.96 0.98 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
      <visual name="rb_f"><pose>0.23 0 0.56 0 0 0</pose><geometry><box><size>0.02 0.34 0.06</size></box></geometry>
