  <model name="ph_w_w"><static>true</static><pose>-6 16 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 10 3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 10 3</size></box></geometry><material><ambient>0.78 0.84 1.0 1</ambient><diffuse>0.78 0.84 1.0 1</diffuse></material></visual></link></model>
  <model name="ph_w_sl"><static>true</static><pose>-3.5 11 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>5 0.2 3</size></box></geometry></collision><visual name="v"><geometry><box><size>5 0.2 3</size></box></geometry><material><ambient>0.78 0.84 1.0 1</ambient><diffuse>0.78 0.84 1.0 1</diffuse></material></visual></link></model>
  <model name="ph_w_sr"><static>true</static><pose>5.5 11 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>5 0.2 3</size></box></geometry></collision><visual name="v"><geometry><box><size>5 0.2 3</size></box></geometry><material><ambient>0.78 0.84 1.0 1</ambient><diffuse>0.78 0.84 1.0 1</diffuse></material></visual></link></model>

  <!-- Étagères médicaments (3 étagères) -->
  <model name="shelf_back1"><static>true</static><pose>0 20.3 1.0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>10 0.35 2</size></box></geometry></collision><visual name="v"><geometry><box><size>10 0.35 2</size></box></geometry><material><ambient>0.55 0.38 0.18 1</ambient><diffuse>0.55 0.38 0.18 1</diffuse></material></visual></link></model>
