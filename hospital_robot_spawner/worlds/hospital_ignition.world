    <visual name="legs"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>0.25 0.22 0.65</size></box></geometry><material><ambient>0.25 0.25 0.7 1</ambient><diffuse>0.25 0.25 0.7 1</diffuse></material></visual>
    <visual name="torso"><pose>0 0 1.05 0 0 0</pose><geometry><box><size>0.32 0.2 0.5</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
    <visual name="head"><pose>0 0 1.45 0 0 0</pose><geometry><sphere><radius>0.13</radius></sphere></geometry><material><ambient>0.75 0.55 0.4 1</ambient><diffuse>0.75 0.55 0.4 1</diffuse></material></visual>
    <visual name="cap"><pose>0 0 1.6 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.06</length></cylinder></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
    <collision name="c"><pose>0 0 0.85 0 0 0</pose><geometry><box><size>0.35 0.25 1.7</size></box></geometry></collision>
  </link></model>

  <!-- Médecin — Blouse blanche + stéthoscope — pharmacie (3, 16) -->
  <model name="doctor_1"><static>true</static><pose>3 16 0 0 0 -0.5</pose><link name="l">
    <visual name="legs"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>0.25 0.22 0.65</size></box></geometry><material><ambient>0.15 0.15 0.4 1</ambient><diffuse>0.15 0.15 0.4 1</diffuse></material></visual>
    <visual name="torso"><pose>0 0 1.05 0 0 0</pose><geometry><box><size>0.35 0.22 0.52</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
    <visual name="steth"><pose>0 0.12 0.95 0.3 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.35</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    <visual name="head"><pose>0 0 1.45 0 0 0</pose><geometry><sphere><radius>0.14</radius></sphere></geometry><material><ambient>0.7 0.55 0.4 1</ambient><diffuse>0.7 0.55 0.4 1</diffuse></material></visual>
    <collision name="c"><pose>0 0 0.85 0 0 0</pose><geometry><box><size>0.38 0.26 1.7</size></box></geometry></collision>
  </link></model>

  <!-- Patient âgé 1 — Avec canne — salle d'attente (4, 10.5) -->
  <model name="elderly_1"><static>true</static><pose>4.5 10.5 0 0 0 2.5</pose><link name="l">
    <visual name="legs"><pose>0 0 0.45 0 0 0</pose><geometry><box><size>0.22 0.2 0.55</size></box></geometry><material><ambient>0.4 0.35 0.55 1</ambient><diffuse>0.4 0.35 0.55 1</diffuse></material></visual>
    <visual name="torso"><pose>0 0 0.94 0.1 0 0</pose><geometry><box><size>0.3 0.19 0.44</size></box></geometry><material><ambient>0.6 0.5 0.38 1</ambient><diffuse>0.6 0.5 0.38 1</diffuse></material></visual>
    <visual name="head"><pose>0 0.04 1.28 0.15 0 0</pose><geometry><sphere><radius>0.12</radius></sphere></geometry><material><ambient>0.78 0.65 0.52 1</ambient><diffuse>0.78 0.65 0.52 1</diffuse></material></visual>
    <!-- Cheveux blancs -->
    <visual name="hair"><pose>0 0.04 1.38 0.15 0 0</pose><geometry><sphere><radius>0.1</radius></sphere></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
    <!-- Canne -->
    <visual name="cane"><pose>0.2 0.15 0.6 0.1 0.1 0</pose><geometry><cylinder><radius>0.018</radius><length>0.95</length></cylinder></geometry><material><ambient>0.4 0.3 0.15 1</ambient><diffuse>0.4 0.3 0.15 1</diffuse></material></visual>
    <collision name="c"><pose>0 0 0.75 0 0 0</pose><geometry><box><size>0.35 0.28 1.5</size></box></geometry></collision>
  </link></model>

  <!-- Patient âgé 2 — Avec canne — couloir vers consultation (1.5, -14) -->
  <model name="elderly_2"><static>true</static><pose>1.5 -14 0 0 0 1.8</pose><link name="l">
    <visual name="legs"><pose>0 0 0.45 0 0 0</pose><geometry><box><size>0.22 0.2 0.55</size></box></geometry><material><ambient>0.35 0.3 0.45 1</ambient><diffuse>0.35 0.3 0.45 1</diffuse></material></visual>
    <visual name="torso"><pose>0 0 0.94 0.08 0 0</pose><geometry><box><size>0.3 0.19 0.44</size></box></geometry><material><ambient>0.55 0.6 0.45 1</ambient><diffuse>0.55 0.6 0.45 1</diffuse></material></visual>
    <visual name="head"><pose>0 0.03 1.27 0.1 0 0</pose><geometry><sphere><radius>0.12</radius></sphere></geometry><material><ambient>0.78 0.65 0.52 1</ambient><diffuse>0.78 0.65 0.52 1</diffuse></material></visual>
    <visual name="hair"><pose>0 0.03 1.37 0.1 0 0</pose><geometry><sphere><radius>0.1</radius></sphere></geometry><material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.88 0.88 0.88 1</diffuse></material></visual>
    <visual name="cane"><pose>0.18 0.12 0.6 0.1 0.08 0</pose><geometry><cylinder><radius>0.018</radius><length>0.92</length></cylinder></geometry><material><ambient>0.35 0.25 0.12 1</ambient><diffuse>0.35 0.25 0.12 1</diffuse></material></visual>
    <collision name="c"><pose>0 0 0.75 0 0 0</pose><geometry><box><size>0.35 0.28 1.5</size></box></geometry></collision>
  </link></model>

  <!-- Patient debout — couloir urgences (-2, -4) -->
  <model name="patient_1"><static>true</static><pose>-2 -4 0 0 0 0.3</pose><link name="l">
    <visual name="legs"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>0.25 0.22 0.65</size></box></geometry><material><ambient>0.2 0.35 0.55 1</ambient><diffuse>0.2 0.35 0.55 1</diffuse></material></visual>
    <visual name="torso"><pose>0 0 1.03 0 0 0</pose><geometry><box><size>0.32 0.2 0.48</size></box></geometry><material><ambient>0.85 0.5 0.5 1</ambient><diffuse>0.85 0.5 0.5 1</diffuse></material></visual>
    <visual name="head"><pose>0 0 1.42 0 0 0</pose><geometry><sphere><radius>0.13</radius></sphere></geometry><material><ambient>0.78 0.62 0.48 1</ambient><diffuse>0.78 0.62 0.48 1</diffuse></material></visual>
    <collision name="c"><pose>0 0 0.85 0 0 0</pose><geometry><box><size>0.35 0.25 1.7</size></box></geometry></collision>
  </link></model>

  <!-- ══ 🤖 ROBOT PIONEER 3AT ════════════════════════════════════════
    Position initiale : Pharmacie (1.0, 16.0)
  ══════════════════════════════════════════════════════════════════ -->
  <model name="PharmaBot">
    <pose>1.0 13.5 0.22 0 0 0</pose>

    <link name="base_link">
      <pose>0 0 0.08 0 0 0</pose>
      <inertial><mass>14.0</mass>
        <inertia><ixx>0.35</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.50</iyy><iyz>0</iyz><izz>0.72</izz></inertia>
      </inertial>
      <collision name="base_col"><geometry><box><size>0.50 0.38 0.18</size></box></geometry></collision>
      <visual name="base_vis"><geometry><box><size>0.50 0.38 0.18</size></box></geometry>
        <material><ambient>0.85 0.08 0.08 1</ambient><diffuse>0.85 0.08 0.08 1</diffuse><specular>0.3 0.1 0.1 1</specular></material></visual>
      <visual name="top"><pose>0 0 0.11 0 0 0</pose><geometry><box><size>0.40 0.30 0.04</size></box></geometry>
        <material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
      <visual name="led"><pose>0.15 0 0.14 0 0 0</pose><geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0 0.5 1 1</ambient><diffuse>0 0.5 1 1</diffuse><emissive>0 0.3 1 1</emissive></material></visual>
      <visual name="antenna"><pose>-0.15 0.1 0.24 0 0 0</pose><geometry><cylinder><radius>0.008</radius><length>0.28</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="cargo"><pose>0 0 0.15 0 0 0</pose><geometry><box><size>0.28 0.22 0.07</size></box></geometry>
        <material><ambient>0.65 0.65 0.88 1</ambient><diffuse>0.65 0.65 0.88 1</diffuse></material></visual>
      <visual name="lidar_body"><pose>0 0 0.20 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.22 0 0 0</pose><topic>/demo/scan</topic><update_rate>10</update_rate>
        <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.12</min><max>10.0</max><resolution>0.01</resolution></range></lidar>
        <always_on>1</always_on><visualize>true</visualize>
      </sensor>
    </link>

    <link name="front_left_wheel"><pose>0.19 0.22 0 0 1.5707 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.005</iyy><iyz>0</iyz><izz>0.009</izz></inertia></inertial>
      <collision name="col"><geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
      <visual name="vis"><geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <visual name="rim"><geometry><cylinder><radius>0.07</radius><length>0.082</length></cylinder></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
    </link>
    <link name="front_right_wheel"><pose>0.19 -0.22 0 0 1.5707 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.005</iyy><iyz>0</iyz><izz>0.009</izz></inertia></inertial>
      <collision name="col"><geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
      <visual name="vis"><geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <visual name="rim"><geometry><cylinder><radius>0.07</radius><length>0.082</length></cylinder></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
    </link>
    <link name="back_left_wheel"><pose>-0.19 0.22 0 0 1.5707 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.005</iyy><iyz>0</iyz><izz>0.009</izz></inertia></inertial>
      <collision name="col"><geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
      <visual name="vis"><geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <visual name="rim"><geometry><cylinder><radius>0.07</radius><length>0.082</length></cylinder></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
    </link>
    <link name="back_right_wheel"><pose>-0.19 -0.22 0 0 1.5707 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.005</iyy><iyz>0</iyz><izz>0.009</izz></inertia></inertial>
      <collision name="col"><geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
      <visual name="vis"><geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <visual name="rim"><geometry><cylinder><radius>0.07</radius><length>0.082</length></cylinder></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
    </link>

    <joint name="front_left_wheel_joint" type="revolute"><parent>base_link</parent><child>front_left_wheel</child><axis><xyz>0 0 1</xyz><dynamics><damping>0.05</damping></dynamics></axis></joint>
    <joint name="front_right_wheel_joint" type="revolute"><parent>base_link</parent><child>front_right_wheel</child><axis><xyz>0 0 1</xyz><dynamics><damping>0.05</damping></dynamics></axis></joint>
    <joint name="back_left_wheel_joint" type="revolute"><parent>base_link</parent><child>back_left_wheel</child><axis><xyz>0 0 1</xyz><dynamics><damping>0.05</damping></dynamics></axis></joint>
    <joint name="back_right_wheel_joint" type="revolute"><parent>base_link</parent><child>back_right_wheel</child><axis><xyz>0 0 1</xyz><dynamics><damping>0.05</damping></dynamics></axis></joint>

    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>back_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>back_right_wheel_joint</right_joint>
      <wheel_separation>0.44</wheel_separation>
      <wheel_radius>0.11</wheel_radius>
      <max_linear_velocity>1.5</max_linear_velocity>
      <max_angular_velocity>2.5</max_angular_velocity>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <topic>/demo/cmd_vel</topic>
      <odom_topic>/demo/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>
    <plugin filename="ignition-gazebo-pose-publisher-system"
            name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <update_frequency>20</update_frequency>
    </plugin>
  </model>

</world>
</sdf>
