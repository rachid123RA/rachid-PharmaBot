      <collision name="c"><geometry><cylinder><radius>0.115</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
      <visual name="p"><geometry><cylinder><radius>0.115</radius><length>0.08</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="j"><geometry><cylinder><radius>0.075</radius><length>0.082</length></cylinder></geometry><material><ambient>0.65 0.66 0.68 1</ambient><diffuse>0.65 0.66 0.68 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
