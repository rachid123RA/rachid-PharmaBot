<?xml version="1.0"?>
<!--
  hospital.world — Hôpital Ibn Tofaïl — PharmaBot Phase 4
  Simulation complète : Entrée/Accueil, Pharmacie, Réanimation, Urgences, Consultation
  Équipements : lits, patients, perfusions, chariots, obstacles
  Robot Pioneer 3AT embarqué (EDF Scheduler)
-->
<sdf version="1.6">
<world name="hospital">

  <!-- ══════════════════════════ PHYSIQUE ══════════════════════════ -->
  <physics type="ode">
    <real_time_update_rate>1000</real_time_update_rate>
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1</real_time_factor>
    <ode><solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver></ode>
  </physics>

  <!-- ══════════════════════════ LUMIÈRES ══════════════════════════ -->
  <light name="sun" type="directional">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 25 0 0 0</pose>
    <diffuse>0.85 0.85 0.85 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular>
    <direction>-0.3 0.1 -0.9</direction>
    <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
  </light>
  <light name="light_entrance" type="point">
    <pose>1.0 -37.0 3.5 0 0 0</pose>
    <diffuse>1.0 1.0 0.9 1</diffuse>
    <attenuation><range>12</range><constant>0.4</constant><linear>0.05</linear><quadratic>0.005</quadratic></attenuation>
    <cast_shadows>false</cast_shadows>
  </light>
  <light name="light_pharmacy" type="point">
    <pose>1.0 16.0 2.8 0 0 0</pose>
    <diffuse>0.6 0.6 1.0 1</diffuse>
    <attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    <cast_shadows>false</cast_shadows>
  </light>
  <light name="light_icu" type="point">
    <pose>11.0 5.5 2.8 0 0 0</pose>
    <diffuse>1.0 0.5 0.5 1</diffuse>
    <attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    <cast_shadows>false</cast_shadows>
  </light>
  <light name="light_emergency" type="point">
    <pose>-5.0 -6.6 2.8 0 0 0</pose>
    <diffuse>1.0 0.65 0.3 1</diffuse>
    <attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    <cast_shadows>false</cast_shadows>
  </light>
  <light name="light_consultation" type="point">
    <pose>-2.0 -27.0 2.8 0 0 0</pose>
    <diffuse>0.5 1.0 0.5 1</diffuse>
    <attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    <cast_shadows>false</cast_shadows>
  </light>
  <light name="light_corridor_1" type="point">
    <pose>1.0 0.0 2.8 0 0 0</pose>
    <diffuse>0.9 0.9 0.9 1</diffuse>
    <attenuation><range>10</range><constant>0.5</constant><linear>0.08</linear><quadratic>0.008</quadratic></attenuation>
    <cast_shadows>false</cast_shadows>
  </light>
  <light name="light_corridor_2" type="point">
    <pose>1.0 -15.0 2.8 0 0 0</pose>
    <diffuse>0.9 0.9 0.9 1</diffuse>
    <attenuation><range>10</range><constant>0.5</constant><linear>0.08</linear><quadratic>0.008</quadratic></attenuation>
    <cast_shadows>false</cast_shadows>
  </light>

  <!-- ══════════════════════════ SOL GÉNÉRAL ══════════════════════ -->
  <model name="hospital_floor">
    <static>true</static>
    <pose>0 -8 0 0 0 0</pose>
    <link name="floor_link">
      <collision name="col"><geometry><box><size>44 80 0.1</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>44 80 0.1</size></box></geometry>
        <material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.88 0.88 0.88 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- ══════════════════════════ MURS EXTÉRIEURS ════════════════════ -->
  <model name="wall_north">
    <static>true</static><pose>2 23 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>42 0.3 3.0</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>42 0.3 3.0</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
    </link>
  </model>
  <!-- Mur Sud principal - ouverture centrale pour l'entrée 5m -->
  <model name="wall_south_west">
    <static>true</static><pose>-9.5 -33 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>21 0.3 3.0</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>21 0.3 3.0</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
    </link>
  </model>
  <model name="wall_south_east">
    <static>true</static><pose>14.0 -33 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>16 0.3 3.0</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>16 0.3 3.0</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
    </link>
  </model>
  <!-- Linteau au-dessus de l'entrée -->
  <model name="wall_south_linteau">
    <static>true</static><pose>1.0 -33 2.7 0 0 0</pose>
    <link name="link">
      <visual name="vis"><geometry><box><size>5 0.3 0.6</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
    </link>
  </model>
  <model name="wall_east">
    <static>true</static><pose>22 -5 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.3 56 3.0</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>0.3 56 3.0</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
    </link>
  </model>
  <model name="wall_west">
    <static>true</static><pose>-18 -5 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.3 56 3.0</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>0.3 56 3.0</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
    </link>
  </model>

  <!-- ═══════════════════════════════════════════════════════════════
       🏥 ENTRÉE / ACCUEIL (y = -33 à -46)
  ═══════════════════════════════════════════════════════════════════ -->
  <!-- Sol entrée - carrelage beige/crème -->
  <model name="entrance_floor">
    <static>true</static><pose>1.0 -39.0 0.07 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>14 13 0.02</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>14 13 0.02</size></box></geometry>
        <material><ambient>0.95 0.93 0.88 1</ambient><diffuse>0.95 0.93 0.88 1</diffuse></material></visual>
    </link>
  </model>
  <!-- Bandes lignes de carrelage -->
  <model name="entrance_tile_h1">
    <static>true</static><pose>1.0 -36 0.08 0 0 0</pose>
    <link name="link"><visual name="vis"><geometry><box><size>14 0.04 0.01</size></box></geometry>
      <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></link>
  </model>
  <model name="entrance_tile_h2">
