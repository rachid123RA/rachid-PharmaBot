  <!-- Plante décorative entrée -->
  <model name="plant_entrance_left">
    <static>true</static><pose>-5.5 -44.5 0.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry></collision>
      <visual name="pot"><geometry><cylinder><radius>0.2</radius><length>0.4</length></cylinder></geometry>
