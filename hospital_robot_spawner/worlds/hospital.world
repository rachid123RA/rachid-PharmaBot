  <!-- ══════════════════════ ROBOT PHARMABOT ══════════════════════════ -->
  <model name="demo">
    <pose>1.0 16.0 0.3 0 0 -1.5708</pose>
    <link name="base_link">
      <pose>0 0 0.1 0 0 0</pose>
      <inertial><mass>15.0</mass><inertia><ixx>0.3738</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.5015</iyy><iyz>0</iyz><izz>0.7243</izz></inertia></inertial>
      <collision name="base_collision"><geometry><box><size>0.50 0.38 0.20</size></box></geometry></collision>
      <visual name="base_visual">
        <geometry><box><size>0.50 0.38 0.20</size></box></geometry>
        <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <visual name="top_visual">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry><box><size>0.40 0.30 0.04</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <visual name="led_visual">
        <pose>0.15 0 0.15 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0 0.5 1 1</ambient><diffuse>0 0.5 1 1</diffuse><emissive>0 0.3 1 1</emissive></material>
      </visual>
      <visual name="cargo_bay">
        <pose>0 0 0.16 0 0 0</pose>
        <geometry><box><size>0.30 0.25 0.08</size></box></geometry>
        <material><ambient>0.7 0.7 0.9 1</ambient><diffuse>0.7 0.7 0.9 1</diffuse></material>
      </visual>
      <sensor name="hokuyo_lidar" type="ray">
        <pose>0.0 0 0.21 0 0 0</pose>
        <always_on>1</always_on><update_rate>10</update_rate><visualize>true</visualize>
        <ray>
          <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.10</min><max>10.0</max><resolution>0.01</resolution></range>
        </ray>
        <plugin name="laser_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros><namespace>/demo</namespace><remapping>~/out:=scan</remapping></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>base_link</frame_name>
        </plugin>
      </sensor>
    </link>
    <link name="front_left_wheel">
      <pose>0.19 0.22 0 0 1.5707 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.0051</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0051</iyy><iyz>0</iyz><izz>0.0090</izz></inertia></inertial>
      <collision name="col"><geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry></collision>
      <visual name="vis"><geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>
    <link name="front_right_wheel">
      <pose>0.19 -0.22 0 0 1.5707 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.0051</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0051</iyy><iyz>0</iyz><izz>0.0090</izz></inertia></inertial>
      <collision name="col"><geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry></collision>
      <visual name="vis"><geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>
    <link name="back_left_wheel">
      <pose>-0.19 0.22 0 0 1.5707 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.0051</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0051</iyy><iyz>0</iyz><izz>0.0090</izz></inertia></inertial>
      <collision name="col"><geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry></collision>
      <visual name="vis"><geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>
    <link name="back_right_wheel">
      <pose>-0.19 -0.22 0 0 1.5707 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.0051</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0051</iyy><iyz>0</iyz><izz>0.0090</izz></inertia></inertial>
      <collision name="col"><geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry></collision>
      <visual name="vis"><geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_left_wheel</child>
      <axis><xyz>0 0 1</xyz><dynamics><damping>0.05</damping></dynamics></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_right_wheel</child>
      <axis><xyz>0 0 1</xyz><dynamics><damping>0.05</damping></dynamics></axis>
    </joint>
    <joint name="back_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>back_left_wheel</child>
      <axis><xyz>0 0 1</xyz><dynamics><damping>0.05</damping></dynamics></axis>
    </joint>
    <joint name="back_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>back_right_wheel</child>
      <axis><xyz>0 0 1</xyz><dynamics><damping>0.05</damping></dynamics></axis>
    </joint>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/demo</namespace></ros>
      <update_rate>20</update_rate>
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>back_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>back_right_wheel_joint</right_joint>
      <wheel_separation>0.44</wheel_separation>
      <wheel_diameter>0.22</wheel_diameter>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <max_wheel_torque>25</max_wheel_torque>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
  </model>

  <!-- ══════════════════════ PLUGIN ROS2 GAZEBO ════════════════════════ -->
  <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
    <ros>
      <namespace>/</namespace>
      <remapping>model_states:=/gazebo/model_states</remapping>
      <remapping>link_states:=/gazebo/link_states</remapping>
    </ros>
    <update_rate>20.0</update_rate>
  </plugin>

