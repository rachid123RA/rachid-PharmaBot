<?xml version="1.0"?>
<!--
  hospital.world — Monde Gazebo 3D pour PharmaBot
  Hôpital complet avec :
    - Pharmacie (1.0, 16.0)  — sol BLEU
    - Réanimation/ICU (11.0, 5.5)   — sol ROUGE
    - Urgences (-5.0, -6.6)  — sol ORANGE
    - Consultation (-2.0, -27.0) — sol VERT
    - Couloir central + couloirs secondaires
    - Étagère médicaments dans la pharmacie
    - Tables de livraison dans chaque département
    - Robot Pioneer 3AT (à spawner via spawn_demo)
-->
<sdf version="1.6">
<world name="hospital">

  <!-- ══════════════════════════ PHYSIQUE ══════════════════════════ -->
  <physics type="ode">
    <real_time_update_rate>1000</real_time_update_rate>
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1</real_time_factor>
    <ode>
      <solver>
        <type>quick</type>
        <iters>50</iters>
        <sor>1.3</sor>
      </solver>
    </ode>
  </physics>

  <!-- ══════════════════════════ LUMIÈRES ══════════════════════════ -->
  <light name="sun" type="directional">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 20 0 0 0</pose>
    <diffuse>0.9 0.9 0.9 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular>
    <direction>-0.5 0.1 -0.9</direction>
    <attenuation>
      <range>1000</range>
      <constant>0.9</constant>
      <linear>0.01</linear>
      <quadratic>0.001</quadratic>
    </attenuation>
  </light>

  <!-- Lumières intérieures de l'hôpital -->
  <light name="light_pharmacy" type="point">
    <pose>1.0 16.0 2.8 0 0 0</pose>
    <diffuse>0.6 0.6 1.0 1</diffuse>
    <specular>0.1 0.1 0.3 1</specular>
    <attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    <cast_shadows>false</cast_shadows>
  </light>
  <light name="light_icu" type="point">
    <pose>11.0 5.5 2.8 0 0 0</pose>
    <diffuse>1.0 0.5 0.5 1</diffuse>
    <specular>0.3 0.1 0.1 1</specular>
    <attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    <cast_shadows>false</cast_shadows>
  </light>
  <light name="light_emergency" type="point">
    <pose>-5.0 -6.6 2.8 0 0 0</pose>
    <diffuse>1.0 0.65 0.3 1</diffuse>
    <specular>0.3 0.2 0.1 1</specular>
    <attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    <cast_shadows>false</cast_shadows>
  </light>
  <light name="light_consultation" type="point">
    <pose>-2.0 -27.0 2.8 0 0 0</pose>
    <diffuse>0.5 1.0 0.5 1</diffuse>
    <specular>0.1 0.3 0.1 1</specular>
    <attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    <cast_shadows>false</cast_shadows>
  </light>

  <!-- ══════════════════════════ SOL GÉNÉRAL ══════════════════════ -->
  <model name="hospital_floor">
    <static>true</static>
    <pose>0 -5 0 0 0 0</pose>
    <link name="floor_link">
      <collision name="floor_col">
        <geometry><box><size>42 70 0.1</size></box></geometry>
      </collision>
      <visual name="floor_vis">
        <geometry><box><size>42 70 0.1</size></box></geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>

  <!-- ══════════════════════════ MURS EXTÉRIEURS ════════════════════ -->
  <!-- Mur Nord -->
  <model name="wall_north">
    <static>true</static>
    <pose>2 23 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>42 0.3 3.0</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>42 0.3 3.0</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
    </link>
  </model>
  <!-- Mur Sud -->
  <model name="wall_south">
    <static>true</static>
    <pose>2 -33 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>42 0.3 3.0</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>42 0.3 3.0</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
    </link>
  </model>
  <!-- Mur Est -->
  <model name="wall_east">
    <static>true</static>
    <pose>22 -5 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.3 56 3.0</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.3 56 3.0</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
    </link>
  </model>
  <!-- Mur Ouest -->
  <model name="wall_west">
    <static>true</static>
    <pose>-18 -5 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.3 56 3.0</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.3 56 3.0</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- ══════════════════════════ COULOIR CENTRAL ════════════════════ -->
  <model name="corridor_floor">
    <static>true</static>
    <pose>1 -5 0.05 0 0 0</pose>
    <link name="link">
      <visual name="vis">
        <geometry><box><size>4 54 0.02</size></box></geometry>
        <material>
          <ambient>0.75 0.75 0.8 1</ambient>
          <diffuse>0.75 0.75 0.8 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

