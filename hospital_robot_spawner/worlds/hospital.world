      <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></link>
  </model>
  <model name="entrance_tile_h3">
    <static>true</static><pose>1.0 -42 0.08 0 0 0</pose>
    <link name="link"><visual name="vis"><geometry><box><size>14 0.04 0.01</size></box></geometry>
      <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></link>
  </model>
  <!-- Murs entrée est/ouest/sud -->
  <model name="entrance_wall_east">
    <static>true</static><pose>8.15 -39 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.3 13 3.0</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>0.3 13 3.0</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
    </link>
  </model>
  <model name="entrance_wall_west">
    <static>true</static><pose>-6.15 -39 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.3 13 3.0</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>0.3 13 3.0</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
    </link>
  </model>
  <!-- Mur sud entrée avec ouverture centrale (2 portes) -->
  <model name="entrance_wall_south_left">
    <static>true</static><pose>-3.5 -45.7 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>5 0.3 3.0</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>5 0.3 3.0</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
    </link>
  </model>
  <model name="entrance_wall_south_right">
    <static>true</static><pose>5.5 -45.7 1.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>5 0.3 3.0</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>5 0.3 3.0</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
    </link>
  </model>
  <!-- Portes automatiques (verre bleuté) -->
  <model name="door_left">
    <static>true</static><pose>-0.7 -45.6 1.0 0 0 0</pose>
    <link name="link"><visual name="vis"><geometry><box><size>1.1 0.06 2.0</size></box></geometry>
      <material><ambient>0.5 0.7 1.0 0.4</ambient><diffuse>0.5 0.7 1.0 0.4</diffuse></material></visual></link>
  </model>
  <model name="door_right">
    <static>true</static><pose>1.7 -45.6 1.0 0 0 0</pose>
    <link name="link"><visual name="vis"><geometry><box><size>1.1 0.06 2.0</size></box></geometry>
      <material><ambient>0.5 0.7 1.0 0.4</ambient><diffuse>0.5 0.7 1.0 0.4</diffuse></material></visual></link>
  </model>
  <!-- Cadre de porte en acier -->
  <model name="door_frame_top">
    <static>true</static><pose>0.5 -45.6 2.15 0 0 0</pose>
    <link name="link"><visual name="vis"><geometry><box><size>3.2 0.1 0.25</size></box></geometry>
      <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual></link>
  </model>

  <!-- BUREAU D'ACCUEIL / RÉCEPTION -->
  <!-- Comptoir d'accueil (forme L) -->
  <model name="reception_desk_front">
    <static>true</static><pose>1.0 -37.5 0.55 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>5.0 0.6 1.1</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>5.0 0.6 1.1</size></box></geometry>
