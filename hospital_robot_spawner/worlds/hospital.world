  <model name="reception_phone">
    <static>true</static><pose>-0.8 -37.3 1.18 0 0 0</pose>
    <link name="link"><visual name="vis"><geometry><box><size>0.2 0.12 0.05</size></box></geometry>
      <material><ambient>0.2 0.3 0.7 1</ambient><diffuse>0.2 0.3 0.7 1</diffuse></material></visual></link>
  </model>

  <!-- Panneau enseigne HÔPITAL IBN TOFAÏL -->
  <model name="sign_hospital_main">
    <static>true</static><pose>1.0 -33.2 2.6 0 0 0</pose>
    <link name="link"><visual name="vis"><geometry><box><size>6.0 0.08 0.6</size></box></geometry>
      <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material></visual></link>
  </model>
  <!-- Croix rouge hôpital sur enseigne -->
  <model name="sign_red_cross_h">
    <static>true</static><pose>1.0 -33.13 2.6 0 0 0</pose>
    <link name="link"><visual name="vis"><geometry><box><size>0.4 0.06 0.12</size></box></geometry>
      <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual></link>
  </model>
  <model name="sign_red_cross_v">
    <static>true</static><pose>1.0 -33.13 2.6 0 0 0</pose>
    <link name="link"><visual name="vis"><geometry><box><size>0.12 0.06 0.4</size></box></geometry>
      <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual></link>
  </model>

  <!-- Chaises salle d'attente -->
  <model name="waiting_chair_1">
    <static>true</static><pose>-4.5 -41.5 0.25 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.45 0.45 0.45</size></box></geometry></collision>
